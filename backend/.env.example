# EthioSec Scanner Environment Configuration

# --------------------------
# Database Configuration
# --------------------------
# For SQLite (Development):
# DATABASE_URL=sqlite:///./ethiosec.db
#
# For PostgreSQL (Production/Testing):
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/ethiosec_db
# 
DATABASE_URL=sqlite:///./ethiosec.db

# --------------------------
# Security
# --------------------------
# Replace with a strong, secure random string in production
JWT_SECRET_KEY=supersecretethioskey_replace_me_in_production

# --------------------------
# Network / Scanning Safety
# --------------------------
# Set to 'true' ONLY in controlled lab environments (like OWASP Juice Shop on localhost)
# DO NOT set to 'true' in production!
ALLOW_LOCAL_TARGETS=false

# --------------------------
# Google OAuth (Optional)
# --------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --------------------------
# Frontend CORS Configuration
# --------------------------
# FRONTEND_URL=http://localhost:5500

# --------------------------
# AI Security Assistant (Ollama)
# --------------------------
# The Ollama API host (default is usually http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
# The model to use
OLLAMA_MODEL=gemma:2b
