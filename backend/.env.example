# EthioSec Scanner Environment Configuration

# -------------------------------------------------------------
# Deployment Environment
# -------------------------------------------------------------
# Set to 'production' for live deployments, or 'development' / 'test' for local work
# In 'production', PostgreSQL is strictly enforced and cannot fall back to SQLite.
ENVIRONMENT=development

# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# For SQLite (Local Development only):
DATABASE_URL=sqlite:///./ethiosec.db
#
# For PostgreSQL (Production):
# DATABASE_URL=postgresql+psycopg2://ethiosec_user:ethiosecpass@localhost:5432/ethiosec_db

# -------------------------------------------------------------
# Cryptography & Session Security
# -------------------------------------------------------------
# Use a strong, random 256-bit secret in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=supersecretethioskey_replace_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REQUIRE_EMAIL_VERIFICATION=true

# -------------------------------------------------------------
# Email Delivery (SMTP)
# -------------------------------------------------------------
# If SMTP is configured, verification codes & password resets are delivered via SMTP.
# In local dev/test mode with empty SMTP settings, emails are captured in memory.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ethiosec.local
SMTP_TLS=true

# -------------------------------------------------------------
# Network / Scanning Safety
# -------------------------------------------------------------
# Set to 'true' ONLY in controlled lab environments (like local OWASP Juice Shop)
# DO NOT set to 'true' in production!
ALLOW_LOCAL_TARGETS=false
VERIFY_SSL=true

# -------------------------------------------------------------
# Frontend CORS & URL Configuration
# -------------------------------------------------------------
FRONTEND_URL=http://localhost:5500
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# -------------------------------------------------------------
# Google OAuth (Optional)
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# -------------------------------------------------------------
# AI Assistant (Gemini / Ollama)
# -------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2
