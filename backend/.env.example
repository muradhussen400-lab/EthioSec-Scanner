# EthioSec Scanner Environment Configuration

# -------------------------------------------------------------
# Deployment Environment
# -------------------------------------------------------------
# Set to 'production' for live deployments, or 'development' / 'test' for local work
# In 'production', PostgreSQL is strictly enforced and cannot fall back to SQLite.
ENVIRONMENT=development

# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# For SQLite (Local Development only):
DATABASE_URL=sqlite:///./ethiosec.db
#
# For PostgreSQL (Production):
# DATABASE_URL=postgresql+psycopg2://ethiosec_user:ethiosecpass@localhost:5432/ethiosec_db

# -------------------------------------------------------------
# Cryptography & Session Security
# -------------------------------------------------------------
# Use a strong, random 256-bit secret in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=supersecretethioskey_replace_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REQUIRE_EMAIL_VERIFICATION=true

# -------------------------------------------------------------
# Email Delivery (SMTP)
# -------------------------------------------------------------
# For Real Gmail SMTP delivery:
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Generate a 16-character App Password (myaccount.google.com/apppasswords)
# 3. Enter your full Gmail address and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM=EthioSec Security <your_email@gmail.com>
# In development/test mode with empty SMTP settings, emails are captured safely in memory.

# -------------------------------------------------------------
# Network / Scanning Safety
# -------------------------------------------------------------
# Set to 'true' ONLY in controlled lab environments (like local OWASP Juice Shop)
# DO NOT set to 'true' in production!
ALLOW_LOCAL_TARGETS=false
VERIFY_SSL=true

# -------------------------------------------------------------
# Frontend CORS & URL Configuration
# -------------------------------------------------------------
FRONTEND_URL=http://localhost:5500
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# -------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect
# -------------------------------------------------------------
# 1. Go to Google Cloud Console (console.cloud.google.com/apis/credentials)
# 2. Create an OAuth 2.0 Client ID (Web Application)
# 3. Add Authorized Redirect URI: http://127.0.0.1:8000/api/auth/google/callback
# 4. Add Authorized JavaScript Origin: http://localhost:5500, http://127.0.0.1:5500
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# -------------------------------------------------------------
# Phone Verification & SMS Provider (Twilio Verify API)
# -------------------------------------------------------------
# 1. Sign up or log into Twilio Console (console.twilio.com)
# 2. Navigate to Explore Products -> Verify -> Services
# 3. Create a Verify Service named 'EthioSec Verification'
# 4. Paste your Account SID, Auth Token, and Verify Service SID below:
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Note: If Twilio credentials are left empty, the system runs in safe development simulation mode.

# -------------------------------------------------------------
# PostgreSQL Database Connection & Pool Settings
# -------------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800


# -------------------------------------------------------------
# AI Assistant (Gemini / Ollama)
# -------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2
