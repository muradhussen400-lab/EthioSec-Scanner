# ==============================================================================
# EthioSec Scanner - Database Configuration Template
# Placeholders only. Copy this file to .env and replace with your local values.
# NEVER commit credentials or passwords to version control.
# ==============================================================================

# Database Connection URL
# PostgreSQL (Production / Testing):
DATABASE_URL=postgresql+psycopg2://<db_user>:<db_password>@<db_host>:5432/<db_name>

# Example for Local Unix Socket:
# DATABASE_URL=postgresql+psycopg2://<db_user>@/<db_name>?host=/tmp

# Example for Local TCP:
# DATABASE_URL=postgresql+psycopg2://ethiosec_user:your_secure_password@localhost:5432/ethiosec_db

# Seed Password for database/seed.py
# Must be at least 8 characters, containing at least 1 uppercase, 1 lowercase, and 1 number.
SEED_PASSWORD=YourSecureDemoPassword123!
